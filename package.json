{
  "name": "call-map",
  "displayName": "Call Map",
  "publisher": "uta-orange-1214",
  "description": "Interactive C/C++ call graph viewer using LSP Call Hierarchy or GNU GLOBAL (gtags). / LSP または GNU GLOBAL (gtags) を使った C/C++ インタラクティブコールグラフビューア。",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/uta1214/call-map"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Visualization", "Programming Languages"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile":           "node esbuild.js",
    "watch":             "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "dependencies": {
    "vis-network": "^9.1.9"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node":   "^20.0.0",
    "esbuild":       "^0.20.0",
    "typescript":    "^5.3.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "callgraph.showFileGraph",
        "title": "Call Map: Show File Call Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "callgraph.showFunctionGraph",
        "title": "Call Map: Show Function Graph (BFS)",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "callgraph.showWorkspaceGraph",
        "title": "Call Map: Analyze Workspace",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "callgraph.showFileGraph",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp",
          "group": "9_callgraph@1"
        },
        {
          "command": "callgraph.showFunctionGraph",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp",
          "group": "9_callgraph@2"
        },
        {
          "command": "callgraph.showWorkspaceGraph",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp",
          "group": "9_callgraph@3"
        }
      ],
      "editor/title": [
        {
          "command": "callgraph.showFileGraph",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp",
          "group": "navigation@1"
        },
        {
          "command": "callgraph.showWorkspaceGraph",
          "when": "editorLangId == c || editorLangId == cpp || editorLangId == cuda-cpp",
          "group": "navigation@2"
        }
      ]
    }
  }
}